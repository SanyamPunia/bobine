{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["src", "../../lib/media-store.ts", "../../lib/media-hls.ts", "../../components/ui/media*.tsx", "../../components/ui/*-player.tsx"]
}
