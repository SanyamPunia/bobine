{
  "name": "bobinejs",
  "version": "0.2.0",
  "description": "Drop-in video and audio players for React. Minimal, themeable, built on composable primitives.",
  "license": "MIT",
  "homepage": "https://bobine.fyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanyamPunia/bobine.git",
    "directory": "packages/bobine"
  },
  "bugs": {
    "url": "https://github.com/SanyamPunia/bobine/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./hls": {
      "types": "./dist/hls.d.ts",
      "import": "./dist/hls.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "hls.js": ">=1.5",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "keywords": [
    "react",
    "video",
    "audio",
    "media-player",
    "video-player",
    "audio-player",
    "hls",
    "shadcn",
    "tailwind"
  ]
}
