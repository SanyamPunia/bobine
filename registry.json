{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "reel",
  "homepage": "https://reel.dev",
  "items": [
    {
      "name": "video-player",
      "type": "registry:ui",
      "title": "Video Player",
      "description": "Drop-in <VideoPlayer src /> with minimal, auto-hiding controls.",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "lib/media-store.ts",
          "type": "registry:lib"
        },
        {
          "path": "components/ui/media-icons.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/media.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/video-player.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "color-media-foreground": "var(--media-foreground)",
          "color-media-scrim": "var(--media-scrim)",
          "ease-media": "cubic-bezier(0.22, 1, 0.36, 1)"
        },
        "light": {
          "media-foreground": "oklch(1 0 0)",
          "media-scrim": "oklch(0 0 0)"
        },
        "dark": {
          "media-foreground": "oklch(1 0 0)",
          "media-scrim": "oklch(0 0 0)"
        }
      }
    },
